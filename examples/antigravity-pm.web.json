{
  "projectName": "Web app",
  "defaultModel": "pro",
  "testCommand": "npm test -- --run",
  "auditCommands": ["npm run lint", "npx tsc --noEmit"],
  "rulesFiles": ["AGENTS.md", "CONTRIBUTING.md"],
  "commitPolicy": "forbid",
  "proof": {
    "require": 2,
    "defaultProvider": "trang",
    "providers": {
      "trang": {
        "type": "shell",
        "command": "npx --yes playwright screenshot --wait-for-timeout=2000 http://localhost:5173 {{out}}"
      },
      "man": { "type": "macos", "region": "0,0,1440,900" }
    }
  }
}
