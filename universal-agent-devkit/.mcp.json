{
  "mcpServers": {
    "codebase-memory-mcp": {
      "command": "codebase-memory-mcp"
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ]
    },
    "android-code-search": {
      "command": "npx",
      "args": [
        "-y",
        "cs-android-mcp@1.0.1"
      ]
    },
    "android-skills": {
      "command": "npx",
      "args": [
        "-y",
        "android-skills-mcp@0.1.7"
      ]
    },
    "replicant-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "replicant-mcp@1.6.7"
      ],
      "env": {
        "ANDROID_HOME": "${ANDROID_HOME:-}"
      }
    },
    "play-store": {
      "command": "play-store-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "${GOOGLE_APPLICATION_CREDENTIALS:-}"
      }
    },
    "antigravity-pm": {
      "command": "node",
      "args": [
        "../antigravity-pm-mcp/bin/antigravity-pm-mcp.js"
      ]
    }
  }
}
